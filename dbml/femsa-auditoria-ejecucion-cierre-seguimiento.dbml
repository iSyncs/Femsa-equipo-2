// FEMSA Auditoria - Equipo 2
// Alcance inicial: ejecucion, cierre y seguimiento
// Version simple con 7 tablas para trabajar primero en dbdiagram.io

Project femsa_auditoria_equipo_2 {
  database_type: "PostgreSQL"
  Note: "Modelo inicial simplificado. Se ampliara en futuros releases."
}

Enum auditoria_estado {
  pendiente
  en_ejecucion
  en_cierre
  cerrada
}

Enum hallazgo_estado {
  abierto
  en_plan_accion
  en_seguimiento
  cerrado
}

Enum plan_estado {
  pendiente
  en_progreso
  vencido
  completado
  validado
}

Table usuarios {
  id integer [pk, increment]
  nombre varchar(150) [not null]
  correo varchar(180) [not null, unique]
  rol varchar(80) [not null]
  area varchar(150)
  activo boolean [not null, default: true]
}

Table auditorias {
  id integer [pk, increment]
  codigo varchar(50) [not null, unique]
  nombre varchar(200) [not null]
  unidad_negocio varchar(150)
  proceso varchar(150)
  responsable_id integer [not null]
  estado auditoria_estado [not null, default: "pendiente"]
  fecha_inicio date
  fecha_fin date
}

Table controles {
  id integer [pk, increment]
  codigo varchar(50) [not null, unique]
  nombre varchar(200) [not null]
  descripcion text
  riesgo_asociado varchar(200)
  responsable_id integer
}

Table auditoria_controles {
  id integer [pk, increment]
  auditoria_id integer [not null]
  control_id integer [not null]
  auditor_id integer
  resultado_diseno varchar(80)
  resultado_efectividad varchar(80)
  conclusion text
}

Table evidencias {
  id integer [pk, increment]
  auditoria_id integer [not null]
  control_id integer
  hallazgo_id integer
  nombre_archivo varchar(255) [not null]
  url_archivo text
  cargado_por_id integer [not null]
  fecha_carga timestamp [not null]
}

Table hallazgos {
  id integer [pk, increment]
  auditoria_id integer [not null]
  control_id integer
  titulo varchar(200) [not null]
  descripcion text [not null]
  severidad varchar(50)
  estado hallazgo_estado [not null, default: "abierto"]
  responsable_id integer
  fecha_identificacion date
}

Table planes_accion {
  id integer [pk, increment]
  hallazgo_id integer [not null]
  descripcion text [not null]
  responsable_id integer [not null]
  estado plan_estado [not null, default: "pendiente"]
  fecha_compromiso date
  avance_porcentaje int [not null, default: 0]
  comentario_seguimiento text
  fecha_ultimo_seguimiento date
}

Ref: auditorias.responsable_id > usuarios.id
Ref: controles.responsable_id > usuarios.id

Ref: auditoria_controles.auditoria_id > auditorias.id
Ref: auditoria_controles.control_id > controles.id
Ref: auditoria_controles.auditor_id > usuarios.id

Ref: evidencias.auditoria_id > auditorias.id
Ref: evidencias.control_id > controles.id
Ref: evidencias.hallazgo_id > hallazgos.id
Ref: evidencias.cargado_por_id > usuarios.id

Ref: hallazgos.auditoria_id > auditorias.id
Ref: hallazgos.control_id > controles.id
Ref: hallazgos.responsable_id > usuarios.id

Ref: planes_accion.hallazgo_id > hallazgos.id
Ref: planes_accion.responsable_id > usuarios.id

