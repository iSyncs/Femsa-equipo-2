// FEMSA Auditoria - Equipo 2
// Alcance inicial: ejecucion, cierre y seguimiento

Table usuarios {
  id integer [primary key]
  nombre varchar
  correo varchar
  rol varchar [note: 'E.g. auditor, jefe, gerente, auditado']
  area varchar
  activo boolean
}

Table auditorias {
  id integer [primary key]
  codigo varchar
  nombre varchar
  unidad_negocio varchar [note: 'E.g. KOF, Proximidad, Spin']
  proceso varchar
  responsable_id integer
  estado varchar [note: 'E.g. pendiente, en_ejecucion, en_cierre, cerrada']
  fecha_inicio date
  fecha_fin date
}

Table controles {
  id integer [primary key]
  codigo varchar
  nombre varchar
  descripcion varchar
  riesgo_asociado varchar
  responsable_id integer
}

Table auditoria_controles {
  id integer [primary key]
  auditoria_id integer
  control_id integer
  auditor_id integer
  resultado_diseno varchar
  resultado_efectividad varchar
  conclusion varchar
}

Table evidencias {
  id integer [primary key]
  auditoria_id integer
  control_id integer
  hallazgo_id integer
  nombre_archivo varchar
  url_archivo varchar
  cargado_por_id integer
  fecha_carga timestamp
}

Table hallazgos {
  id integer [primary key]
  auditoria_id integer
  control_id integer
  titulo varchar
  descripcion varchar
  severidad varchar [note: 'E.g. baja, media, alta, critica']
  estado varchar [note: 'E.g. abierto, en_plan_accion, en_seguimiento, cerrado']
  responsable_id integer
  fecha_identificacion date
}

Table planes_accion {
  id integer [primary key]
  hallazgo_id integer
  descripcion varchar
  responsable_id integer
  estado varchar [note: 'E.g. pendiente, en_progreso, vencido, completado, validado']
  fecha_compromiso date
  avance_porcentaje integer
  comentario_seguimiento varchar
  fecha_ultimo_seguimiento date
}

Ref: auditorias.responsable_id > usuarios.id
Ref: controles.responsable_id > usuarios.id

Ref: auditoria_controles.auditoria_id > auditorias.id
Ref: auditoria_controles.control_id > controles.id
Ref: auditoria_controles.auditor_id > usuarios.id

Ref: evidencias.auditoria_id > auditorias.id
Ref: evidencias.control_id > controles.id
Ref: evidencias.hallazgo_id > hallazgos.id
Ref: evidencias.cargado_por_id > usuarios.id

Ref: hallazgos.auditoria_id > auditorias.id
Ref: hallazgos.control_id > controles.id
Ref: hallazgos.responsable_id > usuarios.id

Ref: planes_accion.hallazgo_id > hallazgos.id
Ref: planes_accion.responsable_id > usuarios.id
