// FEMSA Audit - Team 2
// Initial scope: execution, closing, and follow-up

Table users {
  id integer [primary key]
  name varchar
  email varchar
  role varchar [note: 'E.g. auditor, manager, director, auditee']
  area varchar
  active boolean
}

Table audits {
  id integer [primary key]
  code varchar
  name varchar
  business_unit varchar [note: 'E.g. KOF, Proximity, Spin']
  process varchar
  owner_id integer
  status varchar [note: 'E.g. pending, in_execution, in_closing, closed']
  start_date date
  end_date date
}

Table controls {
  id integer [primary key]
  code varchar
  name varchar
  description varchar
  related_risk varchar
  owner_id integer
}

Table audit_controls {
  id integer [primary key]
  audit_id integer
  control_id integer
  auditor_id integer
  design_result varchar
  effectiveness_result varchar
  conclusion varchar
}

Table evidence {
  id integer [primary key]
  audit_id integer
  control_id integer
  finding_id integer
  file_name varchar
  file_url varchar
  uploaded_by_id integer
  upload_date timestamp
}

Table findings {
  id integer [primary key]
  audit_id integer
  control_id integer
  title varchar
  description varchar
  severity varchar [note: 'E.g. low, medium, high, critical']
  status varchar [note: 'E.g. open, action_plan, follow_up, closed']
  owner_id integer
  identified_date date
}

Table action_plans {
  id integer [primary key]
  finding_id integer
  description varchar
  owner_id integer
  status varchar [note: 'E.g. pending, in_progress, overdue, completed, validated']
  due_date date
  progress_percentage integer
  follow_up_comment varchar
  last_follow_up_date date
}

Ref: audits.owner_id > users.id
Ref: controls.owner_id > users.id

Ref: audit_controls.audit_id > audits.id
Ref: audit_controls.control_id > controls.id
Ref: audit_controls.auditor_id > users.id

Ref: evidence.audit_id > audits.id
Ref: evidence.control_id > controls.id
Ref: evidence.finding_id > findings.id
Ref: evidence.uploaded_by_id > users.id

Ref: findings.audit_id > audits.id
Ref: findings.control_id > controls.id
Ref: findings.owner_id > users.id

Ref: action_plans.finding_id > findings.id
Ref: action_plans.owner_id > users.id
